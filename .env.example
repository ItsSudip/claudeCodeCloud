# ---------------------------------------------------------------- LLM
# "anthropic" (default) or "mock" (offline keyword heuristics, no API calls)
FEED_FILTER_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max - thinking depth / cost (medium is plenty for triage)
ANTHROPIC_EFFORT=medium
FEED_FILTER_LLM_BATCH_SIZE=12     # items per LLM request
FEED_FILTER_LLM_MAX_ITEMS=200     # cap on items scored per run

# ---------------------------------------------------------------- Providers
# Comma-separated subset of: hackernews,reddit,rss,x
FEED_FILTER_PROVIDERS=hackernews,reddit,rss,x
# When a provider fails (auth, rate limit), substitute its bundled fixture so the run completes
FEED_FILTER_ALLOW_MOCK_FALLBACK=true
FEED_FILTER_HTTP_TIMEOUT=20
FEED_FILTER_USER_AGENT=feed-filter/0.1 (contact: you@example.com)

# Reddit - either a ready access token, or client credentials (script app) for the
# client_credentials flow. Create an app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_ACCESS_TOKEN=

# X (Twitter) - strategies are tried in this order:
X_BEARER_TOKEN=                  # 1. official API v2 (developer.x.com)
X_NITTER_BASE_URL=               # 2. a Nitter instance you run, e.g. https://nitter.example.org
X_AUTH_COOKIE=                   # 3. browser cookie string "auth_token=...; ct0=..." for syndication scrape

# ---------------------------------------------------------------- Storage & paths
FEED_FILTER_DATABASE_URL=sqlite:///data/feed_filter.db
FEED_FILTER_PROFILE=interest_profile.md
FEED_FILTER_SOURCES=sources.toml
FEED_FILTER_REPORTS_DIR=reports

# ---------------------------------------------------------------- Dashboard
FEED_FILTER_DASHBOARD_HOST=127.0.0.1
FEED_FILTER_DASHBOARD_PORT=8000
FEED_FILTER_LOG_LEVEL=INFO
